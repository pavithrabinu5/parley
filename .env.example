# Demo is isolated and never calls PayPal or AI providers.
APP_MODE=demo
DATABASE_URL="file:./parley.db"
# Required for sandbox; generate: openssl rand -hex 32
MERCHANT_ACCESS_TOKEN=
APP_ORIGIN=http://localhost:3000
# Sandbox only; production PayPal endpoints are intentionally unavailable.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
# Local AI is the default: install Ollama, then run ollama pull qwen3:4b.
# There is no automatic fallback to OpenAI or a paid model.
AI_PROVIDER=ollama
# Optional Gemini path: select AI_PROVIDER=gemini explicitly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to a model your account can use with Responses structured outputs.
OPENAI_MODEL=gpt-4.1-mini
